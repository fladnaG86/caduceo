[Unit]
Description=Caduceo Relay Server - Remote AI Access
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=manutenzione
Group=manutenzione
WorkingDirectory=/home/caduceo/caduceo
ExecStart=/home/caduceo/caduceo/venv/bin/python -m caduceo_relay --config /home/caduceo/.caduceo/relay.json
Restart=on-failure
RestartSec=5
StartLimitBurst=5


# Sicurezza
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/caduceo/.caduceo /tmp
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=caduceo-relay

[Install]
WantedBy=multi-user.target
