# Caduceo Relay - Caddy reverse proxy
#
# In produzione il traffico passa tramite Cloudflare Tunnel:
#   client → Cloudflare → cloudflared → localhost:8443
#
# Questo Caddyfile serve solo per sviluppo locale sulla porta 8400.

:8400 {
	handle_path /download/* {
		root * /opt/caduceo/deploy
		file_server
	}
	reverse_proxy localhost:8443
}